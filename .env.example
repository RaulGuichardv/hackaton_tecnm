# Copia este archivo como .env en la raíz del proyecto.
# El backend lo carga automáticamente (python-dotenv).

# Base de datos MariaDB/MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=cambia_esta_password
DB_NAME=credetec

# Autenticación administrativa
# Genera un valor aleatorio, por ejemplo: python -c "import secrets; print(secrets.token_hex(32))"
CREDETEC_SECRET_KEY=cambia_esta_clave_por_una_aleatoria
CREDETEC_TOKEN_TTL=43200

# URL del frontend usada en los enlaces de verificación de los correos
PUBLIC_BASE_URL=http://localhost:5173

# Notificaciones SMTP (opcional).
# Si SMTP_HOST está vacío, los correos se guardan en backend/outbox/*.eml.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false
SMTP_STARTTLS=true
SMTP_TIMEOUT=10
